#!/bin/bash
set -euo pipefail


usage() {
    echo "Usage: $0 <commit-message>"
    echo ""
    echo "Stage all files, run full verification, commit, push, and verify CI."
}

BRANCH="$( git branch --show-current)"

wait_for_ci_start() {
  local run_id
  run_id=""
  while [[ -z ${run_id} ]] ; do
    sleep 5
    run_id="$(gh run list --commit "$( git rev-parse HEAD )" --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || echo "" )"
  done
  echo "${run_id}"
}

wait_for_ci_run() {
    gh run watch "$1"
    local conclusion
    conclusion=$(gh run view "$1" --json conclusion --jq '.conclusion' 2>/dev/null || echo "unknown")
    if [ "$conclusion" != "success" ]; then
        echo "CI failed (conclusion: $conclusion)" >&2
        gh run view "$1" --log | grep -i error >&2
        return 1
    fi
    echo "All CI jobs passed."
}


main() {
    if [[ "$BRANCH" = "main" ]]; then
        echo "Error: You are on 'main' branch. Never commit or push directly to main." >&2
        exit 1
    fi
    if [[ "${1+x}" != "x" ]]; then
        usage
        exit 1
    fi

    mise run all-local
    git add -A
    git diff-index --quiet HEAD || git commit -m "$1"
    git rebase origin/main
    git push origin "$BRANCH" --force-with-lease

    if ! gh pr create --fill ; then
      echo "There is already a PR. Just use it."
    fi
    wait_for_ci_run "$( wait_for_ci_start )"

    echo "PR is at: $( gh pr status --jq .currentBranch.url --json url )"
}


main "$@"
